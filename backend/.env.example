# CrossBot AI 环境变量模板 — 复制为 .env 后填写（.env 已被 .gitignore 排除）

# ===== AI（智谱 GLM-4，OpenAI 兼容）=====
# 为空 = Mock 模式；填入后即切换真实生成（含波兰语/罗马尼亚语本地化）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-plus

# ===== 数据库（生产换 Supabase PostgreSQL）=====
# DATABASE_URL=postgresql://user:pass@host:5432/crossbot

# ===== 认证（上线前必改）=====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=30

# ===== Google 登录（可选）=====
# Google Cloud Console → API和服务 → 凭据 → OAuth 客户端 ID（Web）
# 已授权 JS 来源填部署域名，如 https://your-app.up.railway.app
GOOGLE_CLIENT_ID=

# ===== 管理端点（埋点漏斗 /api/v1/analytics/summary 请求头 X-Admin-Token）=====
ADMIN_TOKEN=

# ===== Stripe（上线收款时填）=====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ===== 应用 =====
APP_URL=http://localhost:8000
CORS_ORIGINS=*
